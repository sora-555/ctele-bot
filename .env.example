# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------
BOT_TOKEN=123456:PUT-YOUR-BOTFATHER-TOKEN-HERE
# Your Telegram user id(s), comma separated. Bootstrapped as owners on first run.
ADMIN_IDS=123456789

# ---------------------------------------------------------------------------
# Optional: logging / database
# ---------------------------------------------------------------------------
# Channel id (e.g. -1001234567890) that mirrors admin actions and errors.
LOG_CHANNEL_ID=
DATABASE_URL=sqlite+aiosqlite:///Database.db
LOG_LEVEL=INFO
LOG_DIR=logs

# ---------------------------------------------------------------------------
# Runtime: polling (default) or webhook. FastAPI serves the HTTP layer in both.
# ---------------------------------------------------------------------------
RUN_MODE=polling
API_HOST=0.0.0.0
API_PORT=8080
# Only needed for RUN_MODE=webhook
WEBHOOK_BASE_URL=
WEBHOOK_PATH=/webhook
WEBHOOK_SECRET=
WEBHOOK_DROP_PENDING=true
WEBHOOK_DELETE_ON_SHUTDOWN=false

# ---------------------------------------------------------------------------
# Command menus (registered automatically, no BotFather /setcommands needed)
# ---------------------------------------------------------------------------
SET_COMMANDS_ON_STARTUP=true
COMMAND_SCOPE_ADMINS=true

# ---------------------------------------------------------------------------
# Source (the ctele SDK)
# ---------------------------------------------------------------------------
SOURCE_BASE_URL=https://cosplaytele.com
SOURCE_REFERER=
SOURCE_USER_AGENT=
REQUEST_TIMEOUT=20
MAX_RETRIES=2
SOURCE_CONCURRENCY=8

# ---------------------------------------------------------------------------
# Behaviour
# ---------------------------------------------------------------------------
THROTTLE_RATE=6
THROTTLE_PERIOD=10
ITEMS_PER_PAGE=6
IMAGES_PER_PAGE=5
DEFAULT_DELIVERY_MODE=album
SEARCH_SELECT_TARGET=gallery
SEARCH_THUMBNAILS=true
IMAGE_FALLBACK_UPLOAD=true
AGE_GATE=true
MAINTENANCE=false
# ---------------------------------------------------------------------------
# Numbered navigation (per-user defaults; each user can change theirs in Settings)
# ---------------------------------------------------------------------------
# How many numbers sit either side of the current one in a numbered row (odd, 3-9).
NAV_WINDOW_SIZE=5
# A row with this many numbers or fewer shows all of them instead of a sliding window.
NAV_SHORT_LIST_THRESHOLD=7
# Show the direct page-jump row on screens whose page count is known.
NAV_PAGE_JUMP=true
# Numbers per row in the numbered rows on a keyboard (3-8).
NAV_NUMBERS_PER_ROW=7

# ---------------------------------------------------------------------------
# Caching
# ---------------------------------------------------------------------------
LISTING_CACHE_TTL=300
POST_CACHE_TTL=86400
CATEGORY_CACHE_TTL=21600
SESSION_TTL=1800

# ---------------------------------------------------------------------------
# Auto-delete of media messages (copyright safety)
# ---------------------------------------------------------------------------
AUTO_DELETE_ENABLED=true
AUTO_DELETE_TTL_MINUTES=30
AUTO_DELETE_SCOPE=media
AUTO_DELETE_SWEEP_INTERVAL=60

# ---------------------------------------------------------------------------
# Broadcast
# ---------------------------------------------------------------------------
BROADCAST_RATE=20
